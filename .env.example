# CloudBase 环境
CLOUDBASE_ENV_ID=sqyworkbuddybase-d6exnh2af5c8aef
# PostgREST 基址（默认由 ENV_ID 推导，一般不用改）
# CLOUDBASE_REST_BASE=https://sqyworkbuddybase-d6exnh2af5c8aef.api.tcloudbasegateway.com/v1/rdb/rest
# service_role API Key —— 只在服务端，绝不进前端
CLOUDBASE_API_KEY=在这里填
# 访问密码
ACCESS_PASSWORD=change-me
# 会话签名密钥（不填则从密码派生；换密码会导致所有人掉线）
SESSION_SECRET=
# 表名，默认 memos
MEMOS_TABLE=memos
PORT=8080
