# 访问密码（登录用，也是 token 免密链接的兜底）
ACCESS_PASSWORD=change-me

# SQLite 数据文件位置，默认 ./data/feed.db
# DB_PATH=./data/feed.db

# 会话签名密钥（不填则从密码派生；换密码会导致所有人掉线）
SESSION_SECRET=

# 服务端口
PORT=8080

# 反代是 https 时置 1，给 cookie 加 Secure
# COOKIE_SECURE=1

# ---- 应急文件柜（默认整体禁用：不填 VAULT_KEY 就不可用）----
# 即使填了，也要先 `feed vault open 30m` 授权才能上传/下载/删除
# VAULT_KEY=用 openssl rand -hex 24 生成，客户端配同名 FEED_VAULT_KEY
# VAULT_QUOTA=10485760        # 总空间 10MB
# VAULT_MAX_FILE=2097152      # 单文件 2MB
# VAULT_TTL_HOURS=24          # 24 小时后自动清理，0 = 不清理
# VAULT_DIR=/workspace/.feed-data/vault
